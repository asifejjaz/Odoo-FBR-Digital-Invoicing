<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fbr_invoice_log_list" model="ir.ui.view">
        <field name="name">fbr.invoice.log.list</field>
        <field name="model">fbr.invoice.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-success="state == 'success'" create="0">
                <field name="create_date" string="Submitted At"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="environment"/>
                <field name="attempt_no"/>
                <field name="state"/>
                <field name="status_code"/>
                <field name="fbr_invoice_number"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_fbr_invoice_log_form" model="ir.ui.view">
        <field name="name">fbr.invoice.log.form</field>
        <field name="model">fbr.invoice.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="environment"/>
                            <field name="state"/>
                            <field name="attempt_no"/>
                        </group>
                        <group>
                            <field name="status_code"/>
                            <field name="fbr_invoice_number"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Errors">
                            <field name="errors" widget="text"/>
                        </page>
                        <page string="Request JSON">
                            <field name="request_payload" widget="text"/>
                        </page>
                        <page string="Response JSON">
                            <field name="response_payload" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fbr_invoice_log" model="ir.actions.act_window">
        <field name="name">FBR Submission Log</field>
        <field name="res_model">fbr.invoice.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fbr_invoice_log" name="FBR Submission Log"
              parent="account.menu_finance_reports"
              action="action_fbr_invoice_log"/>
</odoo>
